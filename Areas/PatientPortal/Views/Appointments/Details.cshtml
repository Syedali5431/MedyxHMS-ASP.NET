@model PatientPortalAppointmentDetailsViewModel
@inject MedyxHMS.Services.Interfaces.IHospitalContext HospitalContext
@{
    ViewData["Title"] = "Appointment Details";
    Layout = "~/Areas/PatientPortal/Views/Shared/_Layout.cshtml";
    var appt = Model.Appointment;
}

<div class="py-4" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Appointment Details</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>My Appointments</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h6 class="mb-0">@appt.FormattedAppointmentDate</h6>
            <span class="badge bg-secondary fs-6">@appt.Status</span>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Doctor</div>
                <div class="col-sm-8">@(string.IsNullOrWhiteSpace(appt.DoctorName) ? "—" : appt.DoctorName)</div>
            </div>
            @if (HospitalContext.AllHospitals.Count(h => h.IsActive) > 1 && appt.HospitalId.HasValue)
            {
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Hospital</div>
                <div class="col-sm-8">@HospitalContext.HospitalName(appt.HospitalId)</div>
            </div>
            }
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Specialization</div>
                <div class="col-sm-8">@(string.IsNullOrWhiteSpace(appt.Department) ? "—" : appt.Department)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Reason / symptoms</div>
                <div class="col-sm-8">@(string.IsNullOrWhiteSpace(appt.Symptoms) ? "—" : appt.Symptoms)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Notes</div>
                <div class="col-sm-8" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(appt.Notes) ? "—" : appt.Notes)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 fw-semibold text-muted">Booked on</div>
                <div class="col-sm-8">@appt.CreatedDate.ToString("MMM dd, yyyy")</div>
            </div>
        </div>
    </div>

    @if (Model.CanReschedule || Model.CanCancel)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light"><h6 class="mb-0">Manage this appointment</h6></div>
            <div class="card-body d-flex flex-wrap gap-3 align-items-start">
                @if (Model.CanReschedule)
                {
                    <a asp-action="Reschedule" asp-route-id="@appt.Id" class="btn btn-warning">
                        <i class="fas fa-sync me-1"></i>Reschedule
                    </a>
                }
                @if (Model.CanCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@appt.Id" method="post" class="flex-grow-1"
                          onsubmit="return confirm('Cancel this appointment?');">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" name="reason" class="form-control" placeholder="Reason for cancellation (optional)" maxlength="500" />
                            <button type="submit" class="btn btn-outline-danger"><i class="fas fa-times me-1"></i>Cancel appointment</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
</div>
