@model MedyxHMS.ViewModels.DischargeFormViewModel
@{
    ViewData["Title"] = "Discharge Patient";
}

<div class="container-fluid mt-3 mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-sign-out-alt me-2 text-primary"></i>Discharge Patient</h1>
            <div class="text-muted">
                <strong>@Model.PatientName</strong> (@Model.PatientCode) · @Model.WardBed · admitted @Model.AdmissionDate.ToString("dd-MMM-yyyy hh:mm tt")
            </div>
        </div>
        <a asp-controller="IPD" asp-action="Details" asp-route-id="@Model.AdmissionId" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to admission</a>
    </div>

    <div class="alert alert-light border small">
        <i class="fas fa-info-circle me-1 text-primary"></i>Discharging frees the bed, completes the IPD bill and creates the patient's <strong>discharge report</strong>.
        The details below are taken from the admission, operations and test results – check and complete them. You can save the report as a draft and complete it later.
    </div>

    <form asp-action="Patient" method="post" id="dischargeForm">
        @Html.AntiForgeryToken()
        <partial name="_DischargeForm" model="Model" />
        <input type="hidden" asp-for="Complete" id="completeFlag" />
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <a asp-controller="IPD" asp-action="Details" asp-route-id="@Model.AdmissionId" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-outline-primary" onclick="document.getElementById('completeFlag').value='false'; return confirm('Discharge this patient and save the discharge report as a draft?');">
                <i class="fas fa-save me-1"></i>Discharge and save draft
            </button>
            <button type="submit" class="btn btn-success" onclick="document.getElementById('completeFlag').value='true'; return confirm('Discharge this patient and complete the discharge report?');">
                <i class="fas fa-check me-1"></i>Discharge and complete report
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
