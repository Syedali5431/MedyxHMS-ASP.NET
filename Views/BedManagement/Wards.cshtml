@model List<MedyxHMS.Models.Ward>
@inject MedyxHMS.Services.Interfaces.IHospitalContext HospitalContext
@{
    ViewData["Title"] = "Wards";
    var counts = ViewBag.BedCounts as Dictionary<int, (int Total, int Occupied)> ?? new Dictionary<int, (int Total, int Occupied)>();
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-hospital-alt text-primary me-2"></i>Wards</h4>
            <small class="text-muted">
                Wards and their beds belong to one hospital@(HospitalContext.AllHospitals.Count > 1 ? $" (showing: {HospitalContext.ActiveHospitalName})" : string.Empty).
            </small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-bed me-1"></i>Beds</a>
            <a asp-action="CreateWard" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Ward</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ward</th>
                        <th>Description</th>
                        @if (HospitalContext.ShowHospitalColumn) { <th>Hospital</th> }
                        <th class="text-center">Beds</th>
                        <th class="text-center">Occupied</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        var c = counts.TryGetValue(w.Id, out var v) ? v : (0, 0);
                        <tr>
                            <td><strong>@w.Name</strong></td>
                            <td class="small">@w.Description</td>
                            @if (HospitalContext.ShowHospitalColumn) { <td class="small">@HospitalContext.HospitalName(w.HospitalId)</td> }
                            <td class="text-center">@c.Item1</td>
                            <td class="text-center">@c.Item2</td>
                            <td><span class="badge @(w.IsActive ? "bg-success" : "bg-secondary")">@(w.IsActive ? "Active" : "Inactive")</span></td>
                            <td><a asp-action="EditWard" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No wards yet. Add a ward, then add beds to it.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
