@model MedyxHMS.Models.Vendor
@using MedyxHMS.Controllers
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Vendor" : "Add Vendor";
}

<div class="container mt-3">
    <h4><i class="fas fa-truck text-primary me-2"></i>@ViewData["Title"]</h4>
    <div class="card mt-3 shadow-sm" style="max-width:900px">
        <div class="card-body">
            <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label asp-for="VendorCode" class="form-label fw-semibold"></label>
                        <input asp-for="VendorCode" class="form-control text-uppercase" maxlength="20" placeholder="Auto (V-0001)" />
                        <span asp-validation-for="VendorCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Name" class="form-label fw-semibold">Vendor name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" maxlength="150" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" class="form-select">@foreach (var c in VendorsController.Categories) { <option value="@c">@c</option> }</select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><label asp-for="ContactPerson" class="form-label fw-semibold"></label><input asp-for="ContactPerson" class="form-control" maxlength="100" /></div>
                    <div class="col-md-4"><label asp-for="Phone" class="form-label fw-semibold"></label><input asp-for="Phone" class="form-control" maxlength="50" /></div>
                    <div class="col-md-4"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" maxlength="150" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8"><label asp-for="Address" class="form-label fw-semibold"></label><input asp-for="Address" class="form-control" maxlength="300" /></div>
                    <div class="col-md-4"><label asp-for="City" class="form-label fw-semibold"></label><input asp-for="City" class="form-control" maxlength="100" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><label asp-for="TaxNumber" class="form-label fw-semibold"></label><input asp-for="TaxNumber" class="form-control text-uppercase" maxlength="50" /><span asp-validation-for="TaxNumber" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="LicenseNumber" class="form-label fw-semibold"></label><input asp-for="LicenseNumber" class="form-control" maxlength="100" /></div>
                    <div class="col-md-2"><label asp-for="PaymentTermsDays" class="form-label fw-semibold">Terms (days)</label><input asp-for="PaymentTermsDays" type="number" min="0" max="365" class="form-control" /><span asp-validation-for="PaymentTermsDays" class="text-danger small"></span></div>
                    <div class="col-md-2">
                        <label asp-for="Rating" class="form-label fw-semibold"></label>
                        <select asp-for="Rating" class="form-select"><option value="0">Not rated</option>@for (var i = 1; i <= 5; i++) { <option value="@i">@i ★</option> }</select>
                    </div>
                </div>
                <fieldset class="border rounded p-3 mb-3">
                    <legend class="float-none w-auto px-2 fs-6 fw-semibold">Bank details (visible to finance roles only)</legend>
                    <div class="row g-3">
                        <div class="col-md-3"><label asp-for="BankName" class="form-label small fw-semibold"></label><input asp-for="BankName" class="form-control" maxlength="100" autocomplete="off" /></div>
                        <div class="col-md-3"><label asp-for="BankAccountName" class="form-label small fw-semibold"></label><input asp-for="BankAccountName" class="form-control" maxlength="100" autocomplete="off" /></div>
                        <div class="col-md-3"><label asp-for="BankAccountNumber" class="form-label small fw-semibold"></label><input asp-for="BankAccountNumber" class="form-control" maxlength="50" autocomplete="off" /><span asp-validation-for="BankAccountNumber" class="text-danger small"></span></div>
                        <div class="col-md-3"><label asp-for="BankRoutingCode" class="form-label small fw-semibold"></label><input asp-for="BankRoutingCode" class="form-control text-uppercase" maxlength="30" autocomplete="off" /></div>
                    </div>
                </fieldset>
                <div class="mb-3"><label asp-for="Notes" class="form-label fw-semibold"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
