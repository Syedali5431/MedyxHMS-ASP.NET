@model PatientPortalMedicalRecordDetailsViewModel
@{
    ViewData["Title"] = "Medical Record";
    Layout = "~/Areas/PatientPortal/Views/Shared/_Layout.cshtml";
    var r = Model.MedicalRecord;
}

<div class="py-4" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="fas fa-notes-medical me-2"></i>Medical Record</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Medical Records</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h6 class="mb-0">@r.FormattedRecordDate · @(string.IsNullOrWhiteSpace(r.DoctorName) ? "Doctor not recorded" : r.DoctorName)</h6>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-sm-3 fw-semibold text-muted">Diagnosis</div>
                <div class="col-sm-9" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(r.Diagnosis) ? "—" : r.Diagnosis)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3 fw-semibold text-muted">Treatment</div>
                <div class="col-sm-9" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(r.Treatment) ? "—" : r.Treatment)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3 fw-semibold text-muted">Prescription</div>
                <div class="col-sm-9" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(r.Prescription) ? "—" : r.Prescription)</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3 fw-semibold text-muted">Notes</div>
                <div class="col-sm-9" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</div>
            </div>
        </div>
    </div>
</div>
