@model MedyxHMS.Models.QualityIncident
@using MedyxHMS.Services.Implementations
@{
    ViewData["Title"] = "Incident " + Model.IncidentNumber;
    var isManager = ViewBag.IsManager as bool? ?? false;
    var staff = ViewBag.Staff as List<StaffOption> ?? new List<StaffOption>();
    var closed = Model.Status == "Closed";
}

<div class="container-fluid mt-3" style="max-width:1200px">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-exclamation-triangle text-danger me-2"></i>@Model.IncidentNumber – @Model.Title</h4>
            <small class="text-muted">Reported by @Model.ReportedByName on @Model.ReportedAt.ToString("dd-MMM-yyyy HH:mm")</small>
        </div>
        <a asp-action="Incidents" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Incidents</a>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold">Report</div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5">Status</dt><dd class="col-7"><span class="badge @(closed ? "bg-success" : "bg-secondary")">@Model.Status</span></dd>
                        <dt class="col-5">Severity</dt><dd class="col-7">@Model.Severity</dd>
                        <dt class="col-5">Category</dt><dd class="col-7">@Model.Category</dd>
                        <dt class="col-5">Occurred</dt><dd class="col-7">@Model.OccurredAt.ToString("dd-MMM-yyyy HH:mm")</dd>
                        <dt class="col-5">Location</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Location) ? "–" : Model.Location)</dd>
                        <dt class="col-5">Patient</dt><dd class="col-7">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName} ({Model.Patient.PatientId})" : "–")</dd>
                    </dl>
                    <hr />
                    <div class="fw-semibold">Description</div>
                    <p style="white-space:pre-wrap">@Model.Description</p>
                    <div class="fw-semibold">Immediate action</div>
                    <p class="mb-0" style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.ImmediateAction) ? "–" : Model.ImmediateAction)</p>
                </div>
            </div>
            @if (closed)
            {
                <div class="alert alert-success small">Closed by @Model.ClosedBy on @Model.ClosedAt?.ToString("dd-MMM-yyyy"): @Model.ClosureNotes</div>
            }
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold">Investigation</div>
                <div class="card-body">
                    @if (isManager && !closed)
                    {
                        <form asp-action="UpdateInvestigation" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 mb-2">
                                <div class="col-md-5">
                                    <select name="status" class="form-select form-select-sm">
                                        @foreach (var s in new[] { "Open", "Under investigation", "CAPA in progress" }) { <option value="@s" selected="@(Model.Status == s)">@s</option> }
                                    </select>
                                </div>
                            </div>
                            <textarea name="rootCause" class="form-control form-control-sm mb-2" rows="3" placeholder="Findings of the investigation and root cause (e.g. 5 whys, fishbone)">@Model.RootCause</textarea>
                            <button type="submit" class="btn btn-sm btn-primary">Save investigation</button>
                        </form>
                    }
                    else
                    {
                        <p class="small mb-0" style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.RootCause) ? "Not recorded yet." : Model.RootCause)</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold">Corrective and preventive actions (CAPA)</div>
                <div class="card-body p-0">
                    @{ ViewData["IsManager"] = isManager; ViewData["UserId"] = ViewBag.UserId; }
                    <partial name="_CapaTable" model="Model.CapaActions.OrderBy(c => c.DueDate)" view-data="ViewData" />
                </div>
                @if (isManager && !closed)
                {
                    <div class="card-footer">
                        <form asp-action="AddCapa" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="incidentId" value="@Model.Id" />
                            <div class="col-md-4">
                                <select name="actionType" class="form-select form-select-sm" aria-label="Action type"><option>Corrective</option><option>Preventive</option></select>
                            </div>
                            <div class="col-md-8"><input name="description" class="form-control form-control-sm" placeholder="Action to take" aria-label="Action to take" /></div>
                            <div class="col-md-5">
                                <select name="ownerUserId" class="form-select form-select-sm">
                                    <option value="">Responsible person…</option>
                                    @foreach (var s in staff) { <option value="@s.Id">@s.Name</option> }
                                </select>
                            </div>
                            <div class="col-md-4"><input name="dueDate" type="date" class="form-control form-control-sm" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" aria-label="Due date" /></div>
                            <div class="col-md-3"><button type="submit" class="btn btn-sm btn-success w-100 text-nowrap">Add action</button></div>
                        </form>
                    </div>
                }
            </div>

            @if (isManager && !closed)
            {
                <div class="card shadow-sm border-success">
                    <div class="card-body">
                        <form asp-action="CloseIncident" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-9">
                                <label class="form-label small fw-semibold mb-1">Close incident (all actions must be verified)</label>
                                <input name="closureNotes" class="form-control form-control-sm" placeholder="Outcome and lessons learned" />
                            </div>
                            <div class="col-md-3"><button type="submit" class="btn btn-sm btn-outline-success w-100">Close incident</button></div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
