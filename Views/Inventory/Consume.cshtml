@model MedyxHMS.Controllers.InventoryController.ConsumeInput
@using System.Globalization
@{
    ViewData["Title"] = "Record Consumption";
    var items = ViewBag.Items as List<MedyxHMS.Models.InventoryItem> ?? new List<MedyxHMS.Models.InventoryItem>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    IEnumerable<dynamic> patients = ViewBag.Patients;
}

<div class="container mt-3">
    <h4><i class="fas fa-dolly-flatbed text-info me-2"></i>Record Consumption</h4>
    <p class="text-muted small mb-0">Issue items from stock to a department or ward – optionally for a patient and charged to the patient's bill.</p>
    <div class="card mt-3 shadow-sm" style="max-width:820px">
        <div class="card-body">
            <form asp-action="Consume" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="InventoryItemId" class="form-label fw-semibold">Item <span class="text-danger">*</span></label>
                        <select asp-for="InventoryItemId" class="form-select" id="itemSelect">
                            <option value="0">Choose…</option>
                            @foreach (var i in items)
                            {
                                <option value="@i.Id" data-cost="@i.UnitCost.ToString(CultureInfo.InvariantCulture)">@i.Name (@i.ItemCode) – @i.CurrentStock.ToString("0.##", CultureInfo.InvariantCulture) @i.Unit in stock</option>
                            }
                        </select>
                        <span asp-validation-for="InventoryItemId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold">Department / ward <span class="text-danger">*</span></label>
                        <input asp-for="Department" class="form-control" list="deptList" maxlength="100" />
                        <datalist id="deptList">@foreach (var d in departments) { <option value="@d"></option> }</datalist>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PatientId" class="form-label fw-semibold">Patient (optional)</label>
                        <select asp-for="PatientId" class="form-select">
                            <option value="">— None —</option>
                            @foreach (var p in patients) { <option value="@p.Id">@p.Name</option> }
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3 align-items-end">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input asp-for="ChargeToPatient" class="form-check-input" id="chargeBox" />
                            <label class="form-check-label" for="chargeBox">Charge to the patient's bill</label>
                        </div>
                        <div class="form-text">Added to today's open "Consumables" bill of the patient (a new bill is opened if needed).</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UnitPrice" class="form-label fw-semibold">Price per unit (if charged)</label>
                        <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" id="priceInput" />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3"><label asp-for="Notes" class="form-label fw-semibold"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Issue items</button>
                    <a asp-action="Consumption" class="btn btn-outline-secondary">Consumption report</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('itemSelect'), price = document.getElementById('priceInput');
            sel && sel.addEventListener('change', function () {
                var opt = sel.options[sel.selectedIndex];
                if (price && !price.value && opt && opt.dataset.cost) price.value = opt.dataset.cost;
            });
        })();
    </script>
}
