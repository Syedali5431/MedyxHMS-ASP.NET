@model PatientPortalPasswordChangeViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Areas/PatientPortal/Views/Shared/_Layout.cshtml";
}

<div class="py-4" style="max-width:520px">
    <h3 class="mb-4"><i class="fas fa-key me-2"></i>Change Password</h3>

    <form asp-action="ChangePassword" method="post" class="card shadow-sm">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="PasswordChange.CurrentPassword" class="form-label">Current password</label>
                <input asp-for="PasswordChange.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="PasswordChange.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PasswordChange.NewPassword" class="form-label">New password</label>
                <input asp-for="PasswordChange.NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordChange.NewPassword" class="text-danger small"></span>
                <div class="form-text">At least 8 characters, with an upper-case letter, a lower-case letter and a number.</div>
            </div>
            <div class="mb-3">
                <label asp-for="PasswordChange.ConfirmPassword" class="form-label">Confirm new password</label>
                <input asp-for="PasswordChange.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="PasswordChange.ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Change password</button>
            <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
