@model MedyxHMS.Components.ProfileImageModel
@{
    var title = string.IsNullOrEmpty(Model.Name) ? "My Profile" : Model.Name + " – My Profile";
}
@if (!string.IsNullOrEmpty(Model.LinkUrl))
{
    <a href="@Model.LinkUrl" title="@title" class="d-inline-flex">
        <img src="@Model.ImageUrl" alt="Profile picture" class="rounded-circle border" style="width:@(Model.Size)px;height:@(Model.Size)px;object-fit:cover;" />
    </a>
}
else
{
    <img src="@Model.ImageUrl" alt="Profile picture" class="rounded-circle border" style="width:@(Model.Size)px;height:@(Model.Size)px;object-fit:cover;" />
}
