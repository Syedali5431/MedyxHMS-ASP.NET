@model MedyxHMS.Models.Hospital
@{
    ViewData["Title"] = "Edit Hospital";
}

<div class="container mt-3">
    <h4><i class="fas fa-hospital text-primary me-2"></i>Edit Hospital</h4>
    <div class="card mt-3 shadow-sm" style="max-width:760px">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Access" asp-route-id="@Model.Id" class="btn btn-outline-primary">Staff Access</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
