@model MedyxHMS.DTOs.PrescriptionDto
@{
    ViewData["Title"] = $"Prescription #{Model.Id}";
}

<div class="container mt-3" style="max-width:760px">
    <div class="d-flex align-items-center mb-3 gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Prescriptions
        </a>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-print me-1"></i>Print
        </button>
        @if (Model.PharmacyBillId > 0)
        {
            <a asp-action="ThermalPharmacyBill" asp-route-id="@Model.PharmacyBillId" asp-route-prescriptionId="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="Print the pharmacy bill on the receipt printer">
                <i class="fas fa-receipt me-1"></i>Pharmacy Bill Receipt
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-prescription-bottle-alt me-2"></i>Prescription #@Model.Id</h5>
            <small class="text-muted">Created @Model.FormattedCreatedDate · Pharmacy bill #@Model.PharmacyBillId</small>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Medicine</div>
                <div class="col-8">
                    @(string.IsNullOrWhiteSpace(Model.MedicineName) ? "—" : Model.MedicineName)
                    @if (Model.MedicineId > 0)
                    {
                        <a asp-action="MedicineDetails" asp-route-id="@Model.MedicineId" class="ms-2 small">View medicine</a>
                    }
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Dosage</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Dosage) ? "—" : Model.Dosage)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Frequency</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Frequency) ? "—" : Model.Frequency)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Duration</div>
                <div class="col-8">@Model.Duration day(s)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Quantity</div>
                <div class="col-8">@Model.Quantity</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Unit price</div>
                <div class="col-8">@Model.UnitPrice.ToString("N2")</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Total price</div>
                <div class="col-8 fw-semibold">@Model.TotalPrice.ToString("N2")</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Instructions</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Instructions) ? "—" : Model.Instructions)</div>
            </div>
        </div>
    </div>
</div>
