@model MedyxHMS.Models.InternalAudit
@using MedyxHMS.Services.Implementations
@{
    ViewData["Title"] = "Plan Internal Audit";
}

<div class="container mt-3">
    <h4><i class="fas fa-clipboard-check text-info me-2"></i>Plan Internal Audit</h4>
    <div class="card mt-3 shadow-sm" style="max-width:760px">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="200" placeholder="e.g. Pharmacy storage and dispensing" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Scope" class="form-label fw-semibold">Scope <span class="text-danger">*</span></label>
                    <input asp-for="Scope" class="form-control" maxlength="200" />
                    <span asp-validation-for="Scope" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Standard" class="form-label fw-semibold"></label>
                        <select asp-for="Standard" class="form-select">
                            @foreach (var s in QualityService.AuditStandards) { <option value="@s">@s</option> }
                        </select>
                        <span asp-validation-for="Standard" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PlannedDate" class="form-label fw-semibold"></label>
                        <input asp-for="PlannedDate" type="date" class="form-control" value="@Model.PlannedDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LeadAuditor" class="form-label fw-semibold"></label>
                        <input asp-for="LeadAuditor" class="form-control" maxlength="100" />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
