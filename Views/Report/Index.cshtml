@model MedyxHMS.ViewModels.ReportsWorkspaceViewModel
@{
    ViewData["Title"] = "Reports Workspace";
    var selected = Model.SelectedReport;
    var document = ViewData["ReportDocument"] as MedyxHMS.ViewModels.ReportDocument;
    var reportError = ViewData["ReportError"] as string;
}

<div class="container-fluid mt-3 mb-4">
    @if (document != null)
    {
        @* A data report: full width, the report itself is the page. *@
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 d-print-none">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index"><i class="fas fa-chart-line me-1"></i>Reports</a></li>
                    <li class="breadcrumb-item">@document.Category</li>
                    <li class="breadcrumb-item active" aria-current="page">@document.Title</li>
                </ol>
            </nav>
            <div class="d-flex gap-2 flex-wrap">
                @if (selected != null && !string.IsNullOrWhiteSpace(selected.EmbeddedUrl))
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@selected.EmbeddedUrl" target="_blank" rel="noopener"><i class="fas fa-external-link-alt me-1"></i>Open in new tab</a>
                }
                @if (Model.MatchingTemplateId.HasValue && Model.CanManageTemplates)
                {
                    <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Design", "Report", new { id = Model.MatchingTemplateId.Value })"><i class="fas fa-drafting-compass me-1"></i>Template builder</a>
                }
            </div>
        </div>
        <partial name="_ReportDocument" model="document" />
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1"><i class="fas fa-chart-line me-2 text-primary"></i>Reports Workspace</h1>
                <p class="text-muted mb-0">Choose a report below or from the Reports list in the sidebar. Every report can be printed and downloaded as PDF or Excel.</p>
            </div>
            <span class="badge text-bg-dark">@Model.Items.Count reports</span>
        </div>

        @if (!string.IsNullOrEmpty(reportError))
        {
            <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-1"></i>@reportError</div>
        }

        @if (selected == null)
        {
            @* Report directory grouped by category *@
            <div class="row g-3">
                @foreach (var group in Model.Items.GroupBy(i => i.Category))
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white fw-semibold"><i class="fas fa-folder-open text-primary me-1"></i>@group.Key <span class="badge bg-light text-dark border ms-1">@group.Count()</span></div>
                            <div class="list-group list-group-flush">
                                @foreach (var item in group)
                                {
                                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2" href="@Url.Action("Index", new { reportKey = item.Key })">
                                        <span>@item.Name</span>
                                        <span class="badge bg-light text-muted border">@item.Key</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h2 class="h5 mb-0">@selected.Key · @selected.Name</h2>
                        </div>
                        <div class="card-body">
                            <dl class="row small mb-3">
                                <dt class="col-sm-5 text-muted">Category</dt>
                                <dd class="col-sm-7">@selected.Category</dd>
                                <dt class="col-sm-5 text-muted">Summary</dt>
                                <dd class="col-sm-7">@selected.Summary</dd>
                                @if (!string.IsNullOrWhiteSpace(Model.MatchingTemplateName))
                                {
                                    <dt class="col-sm-5 text-muted">Mapped Template</dt>
                                    <dd class="col-sm-7 text-success">@Model.MatchingTemplateName</dd>
                                }
                            </dl>

                            <div class="d-grid gap-2">
                                @if (!string.IsNullOrWhiteSpace(selected.EmbeddedUrl))
                                {
                                    <a class="btn btn-primary" href="@selected.EmbeddedUrl" target="_blank" rel="noopener">Open Standalone</a>
                                }

                                @if (Model.MatchingTemplateId.HasValue && Model.CanManageTemplates)
                                {
                                    <a class="btn btn-outline-primary" href="@Url.Action("Design", "Report", new { id = Model.MatchingTemplateId.Value })">Open Template Builder</a>
                                    <a class="btn btn-outline-secondary" href="@Url.Action("Preview", "Report", new { id = Model.MatchingTemplateId.Value })">Preview Template</a>
                                }

                                @if (selected.Key == "R49" && Model.PreviewableTemplates.Any())
                                {
                                    <div class="border rounded p-3 bg-light">
                                        <div class="fw-semibold mb-2">Previewable Templates</div>
                                        <div class="d-flex flex-column gap-2 small">
                                            @foreach (var template in Model.PreviewableTemplates)
                                            {
                                                <a href="@Url.Action("Preview", "Report", new { id = template.Id })">@template.Name</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-8">
                    <div class="card shadow-sm workspace-card">
                        <div class="card-header bg-white">
                            <h2 class="h5 mb-0">Report Detail</h2>
                        </div>
                        <div class="card-body p-0">
                            @if (!string.IsNullOrWhiteSpace(selected.EmbeddedUrl))
                            {
                                <iframe src="@selected.EmbeddedUrl" title="@selected.Name" style="width:100%;min-height:900px;border:0;"></iframe>
                            }
                            else if (selected.Key == "R48")
                            {
                                <div class="p-4">
                                    <div class="alert alert-dark">
                                        <div class="fw-semibold mb-1">Legacy PHP Report Import</div>
                                        <div>Import migrated PHP report templates so they become editable and previewable in the ASP.NET report builder flow.</div>
                                    </div>

                                    @if (Model.CanManageTemplates)
                                    {
                                        <form asp-action="ImportLegacyPhpReports" method="post" class="mb-3">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-dark">Import Legacy PHP Reports</button>
                                        </form>
                                    }

                                    <div class="text-muted small">Imported template count: @Model.ImportedLegacyTemplateCount</div>
                                </div>
                            }
                            else if (selected.Key == "R49")
                            {
                                <div class="p-4">
                                    <div class="alert alert-primary mb-0">
                                        <div class="fw-semibold mb-1">Report Preview</div>
                                        <div>Use the preview links in the left panel to open saved or imported report template previews.</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-muted">This report could not be shown. Choose another report from the list.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .workspace-card {
        min-height: 60vh;
    }
</style>
