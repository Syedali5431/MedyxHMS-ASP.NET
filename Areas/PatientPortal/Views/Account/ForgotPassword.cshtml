@model PatientPortalForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Areas/PatientPortal/Views/Shared/_Layout.cshtml";
}

<div class="py-5 mx-auto" style="max-width:460px">
    <form asp-action="ForgotPassword" method="post" class="card shadow-sm">
        @Html.AntiForgeryToken()
        <div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="fas fa-unlock-alt me-2"></i>Forgot Password</h5></div>
        <div class="card-body">
            <p class="text-muted">Enter the e-mail address of your patient portal account. If it exists, we will send you a link to reset your password.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-mail address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
        </div>
        <div class="card-footer text-center">
            <a asp-action="Login">Back to login</a>
        </div>
    </form>
</div>
