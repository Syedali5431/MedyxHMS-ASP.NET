@model MedyxHMS.ViewModels.ControlledDocumentCreateViewModel
@using MedyxHMS.Services.Implementations
@{
    ViewData["Title"] = "New Controlled Document";
}

<div class="container mt-3">
    <h4><i class="fas fa-file-signature text-primary me-2"></i>New Controlled Document</h4>
    <div class="card mt-3 shadow-sm" style="max-width:820px">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Document.DocumentNumber" class="form-label fw-semibold">Document no. <span class="text-danger">*</span></label>
                        <input asp-for="Document.DocumentNumber" class="form-control text-uppercase" maxlength="30" placeholder="e.g. SOP-LAB-001" />
                        <span asp-validation-for="Document.DocumentNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Document.Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input asp-for="Document.Title" class="form-control" maxlength="200" />
                        <span asp-validation-for="Document.Title" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Document.Category" class="form-label fw-semibold">Category</label>
                        <select asp-for="Document.Category" class="form-select">
                            @foreach (var c in QualityService.DocumentCategories) { <option value="@c">@c</option> }
                        </select>
                        <span asp-validation-for="Document.Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Document.Department" class="form-label fw-semibold"></label>
                        <input asp-for="Document.Department" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Document.ReviewIntervalMonths" class="form-label fw-semibold"></label>
                        <input asp-for="Document.ReviewIntervalMonths" type="number" min="1" max="60" class="form-control" />
                        <span asp-validation-for="Document.ReviewIntervalMonths" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="File" class="form-label fw-semibold">Document file (version 1) <span class="text-danger">*</span></label>
                        <input asp-for="File" type="file" class="form-control" accept="@string.Join(",", QualityService.AllowedDocumentExtensions)" />
                        <span asp-validation-for="File" class="text-danger small"></span>
                        <div class="form-text">PDF, Word, Excel, PowerPoint, text or image; up to 20 MB. Stored privately (not on the public website).</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ChangeSummary" class="form-label fw-semibold">Change summary</label>
                        <input asp-for="ChangeSummary" class="form-control" maxlength="300" />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create draft</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
