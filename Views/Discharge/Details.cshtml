@model MedyxHMS.Models.DischargeSummary
@{
    ViewData["Title"] = "Discharge Report " + Model.ReportNumber;
    var document = (MedyxHMS.ViewModels.ReportDocument)ViewData["ReportDocument"]!;
    var isManager = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<div class="container-fluid mt-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 d-print-none">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index"><i class="fas fa-file-medical me-1"></i>Discharge Reports</a></li>
                <li class="breadcrumb-item">@Model.Patient?.FirstName @Model.Patient?.LastName</li>
                <li class="breadcrumb-item active" aria-current="page">@Model.ReportNumber</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (Model.IsCompleted)
            {
                <span class="badge text-bg-success"><i class="fas fa-check me-1"></i>Completed @Model.CompletedAt?.ToString("dd-MMM-yyyy")</span>
            }
            else
            {
                <span class="badge text-bg-warning">Draft</span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-success"><i class="fas fa-pen me-1"></i>Complete report</a>
            }
            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm rpt-btn-pdf"><i class="fas fa-file-pdf me-1"></i>Download PDF</a>
            <button type="button" class="btn btn-sm btn-outline-dark" onclick="window.print()"><i class="fas fa-print me-1"></i>Print</button>
            <a asp-controller="IPD" asp-action="Details" asp-route-id="@Model.IPDAdmissionId" class="btn btn-sm btn-outline-secondary"><i class="fas fa-bed me-1"></i>Admission</a>
            @if (Model.IsCompleted && isManager)
            {
                <form asp-action="Reopen" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Reopen the completed report for corrections?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning"><i class="fas fa-undo me-1"></i>Reopen</button>
                </form>
            }
        </div>
    </div>

    @{ ViewData["ReportHideToolbar"] = true; }
    <partial name="~/Views/Report/_ReportDocument.cshtml" model="document" />
</div>
