@model MedyxHMS.DTOs.MedicineUpdateDto

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-pills"></i> Edit Medicine</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Medicines", "Prescription")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Medicines
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Medicine Information</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="EditMedicine">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">Name</label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="GenericName" class="form-label">Generic Name</label>
                                    <input asp-for="GenericName" class="form-control" />
                                    <span asp-validation-for="GenericName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label">Category</label>
                                    <input asp-for="Category" class="form-control" />
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="DosageForm" class="form-label">Dosage Form</label>
                                    <input asp-for="DosageForm" class="form-control" />
                                    <span asp-validation-for="DosageForm" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Strength" class="form-label">Strength</label>
                                    <input asp-for="Strength" class="form-control" />
                                    <span asp-validation-for="Strength" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Manufacturer" class="form-label">Manufacturer</label>
                            <input asp-for="Manufacturer" class="form-control" />
                            <span asp-validation-for="Manufacturer" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="UnitPrice" class="form-label">Unit Price</label>
                                    <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="StockQuantity" class="form-label">Stock Quantity</label>
                                    <input asp-for="StockQuantity" type="number" class="form-control" />
                                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="MinStockLevel" class="form-label">Minimum Stock Level</label>
                                    <input asp-for="MinStockLevel" type="number" class="form-control" />
                                    <span asp-validation-for="MinStockLevel" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BatchNumber" class="form-label">Batch Number</label>
                                    <input asp-for="BatchNumber" class="form-control" />
                                    <span asp-validation-for="BatchNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" id="isActive" value="true" />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a href="@Url.Action("Medicines", "Prescription")" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
