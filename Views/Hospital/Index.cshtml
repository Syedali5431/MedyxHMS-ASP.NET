@model List<MedyxHMS.ViewModels.HospitalListItemViewModel>
@inject MedyxHMS.Services.Interfaces.IHospitalContext HospitalContext
@{
    ViewData["Title"] = "Hospitals / Branches";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-hospital text-primary me-2"></i>Hospitals / Branches</h4>
            <small class="text-muted">Patients, staff and master data are shared across the group. Appointments, OPD, IPD, wards and beds, bills, pharmacy bills, inventory and OT schedules belong to one hospital.</small>
        </div>
        @if (ViewBag.CanAddHospitals == true)
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Hospital</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="alert alert-info small py-2">
        <i class="fas fa-info-circle me-1"></i>
        You are working in <strong>@HospitalContext.ActiveHospitalName</strong>. Use the hospital selector in the top bar to switch.
        Staff with no hospital assigned work in the default hospital.
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Hospital</th>
                        <th>City</th>
                        <th>Phone</th>
                        <th class="text-center">Staff assigned</th>
                        <th class="text-center">Wards</th>
                        <th class="text-center">Appointments</th>
                        <th class="text-center">Admitted now</th>
                        <th class="text-center">Bills</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var h = row.Hospital;
                        <tr>
                            <td><code>@h.Code</code></td>
                            <td>
                                <strong>@h.Name</strong>
                                @if (h.IsDefault) { <span class="badge bg-primary ms-1">Default</span> }
                                @if (!string.IsNullOrWhiteSpace(h.Address)) { <div class="small text-muted">@h.Address</div> }
                            </td>
                            <td>@h.City</td>
                            <td>@h.Phone</td>
                            <td class="text-center">@row.StaffAssigned</td>
                            <td class="text-center">@row.Wards</td>
                            <td class="text-center">@row.Appointments</td>
                            <td class="text-center">@row.CurrentAdmissions</td>
                            <td class="text-center">@row.Bills</td>
                            <td><span class="badge @(h.IsActive ? "bg-success" : "bg-secondary")">@(h.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Access" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Staff Access</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">No hospitals registered.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
