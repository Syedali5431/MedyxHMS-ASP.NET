@model MedyxHMS.ViewModels.BackupsViewModel
@{
    ViewData["Title"] = "Database Backups";
    string Size(long? bytes) => bytes == null ? "–" : bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{bytes / 1024d:0} KB";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-database text-primary me-2"></i>Database Backups</h4>
            <small class="text-muted">Database <code>@Model.DatabaseName</code> → <code>@(string.IsNullOrEmpty(Model.EffectiveFolder) ? "(no folder)" : Model.EffectiveFolder)</code> on the database server.</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Security settings</a>
            <form asp-action="BackupNow" method="post" class="d-inline" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').innerText = 'Backing up…';">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save me-1"></i>Back up now</button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="alert alert-light border small py-2">
        Each backup is a full, copy-only backup (it does not disturb backups scheduled by your database administrator) and is checked with
        <em>RESTORE VERIFYONLY</em>. Copy backup files to another location (another server or offline storage) regularly.
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Started</th><th>File</th><th>Size</th><th>Status</th><th>Verified</th><th>By</th><th>Message</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.History)
                    {
                        <tr>
                            <td class="text-nowrap">@b.StartedAt.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td class="small"><code>@b.FilePath</code></td>
                            <td class="text-nowrap">@Size(b.SizeBytes)</td>
                            <td>
                                <span class="badge @(b.Status == "Succeeded" ? "bg-success" : b.Status == "Failed" ? "bg-danger" : "bg-secondary")">@b.Status</span>
                            </td>
                            <td>@(b.Verified ? "Yes" : "No")</td>
                            <td class="small">@b.CreatedBy</td>
                            <td class="small">@b.Message</td>
                        </tr>
                    }
                    @if (!Model.History.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No backups have been taken from here yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
