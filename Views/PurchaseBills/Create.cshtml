@model MedyxHMS.Models.PurchaseBill
@{
    ViewData["Title"] = "New Purchase Bill";
    var vendors = ViewBag.Vendors as List<MedyxHMS.Models.Vendor> ?? new List<MedyxHMS.Models.Vendor>();
}

<div class="container mt-3">
    <h4><i class="fas fa-file-invoice-dollar text-primary me-2"></i>New Purchase Bill</h4>
    <p class="text-muted small mb-0">Enter the vendor's invoice; the items are added on the next page.</p>
    <div class="card mt-3 shadow-sm" style="max-width:760px">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="VendorId" class="form-label fw-semibold">Vendor <span class="text-danger">*</span></label>
                        <select asp-for="VendorId" class="form-select">
                            <option value="0">Choose…</option>
                            @foreach (var v in vendors) { <option value="@v.Id">@v.Name (@v.VendorCode) – @v.PaymentTermsDays days</option> }
                        </select>
                        <span asp-validation-for="VendorId" class="text-danger small"></span>
                        @if (!vendors.Any()) { <div class="form-text text-danger">No active vendors – add one under Inventory → Vendors first.</div> }
                    </div>
                    <div class="col-md-5">
                        <label asp-for="VendorInvoiceNumber" class="form-label fw-semibold">Vendor invoice no. <span class="text-danger">*</span></label>
                        <input asp-for="VendorInvoiceNumber" class="form-control" maxlength="50" />
                        <span asp-validation-for="VendorInvoiceNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="InvoiceDate" class="form-label fw-semibold"></label>
                        <input asp-for="InvoiceDate" type="date" class="form-control" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DueDate" class="form-label fw-semibold"></label>
                        <input asp-for="DueDate" type="date" class="form-control" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="useVendorTerms" value="true" id="useTerms" checked />
                            <input type="hidden" name="useVendorTerms" value="false" />
                            <label class="form-check-label small" for="useTerms">Due date from the vendor's payment terms</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3"><label asp-for="Notes" class="form-label fw-semibold"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create draft</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
