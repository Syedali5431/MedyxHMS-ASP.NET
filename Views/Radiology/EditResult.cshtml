@model MedyxHMS.Models.RadiologyResult
@{
    ViewData["Title"] = "Edit Radiology Result";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-x-ray"></i> Edit Radiology Result — Order #@Model.OrderNumber</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="EditResult" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="OrderNumber" />
                        <input type="hidden" asp-for="PatientId" />
                        <input type="hidden" asp-for="RadiologyTestId" />
                        <input type="hidden" asp-for="OrderDate" />

                        <div class="mb-3">
                            <label asp-for="Findings" class="form-label"></label>
                            <textarea asp-for="Findings" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Findings" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Impression" class="form-label"></label>
                            <textarea asp-for="Impression" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Impression" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ResultDate" class="form-label"></label>
                            <input asp-for="ResultDate" type="datetime-local" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PerformedBy" class="form-label"></label>
                            <input asp-for="PerformedBy" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="ResultDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
