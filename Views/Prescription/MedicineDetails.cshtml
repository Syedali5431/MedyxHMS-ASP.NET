@model MedyxHMS.DTOs.MedicineDto
@{
    ViewData["Title"] = $"Medicine — {Model.Name}";
}

<div class="container mt-3" style="max-width:760px">
    <div class="d-flex align-items-center mb-3 gap-2">
        <a asp-action="Medicines" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Medicines
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <a asp-action="EditMedicine" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0"><i class="fas fa-pills me-2"></i>@Model.Name</h5>
                <small class="text-muted">@(string.IsNullOrWhiteSpace(Model.GenericName) ? "" : Model.GenericName)</small>
            </div>
            <div>
                <span class="badge @Model.StockStatusBadgeClass">@Model.StockStatus</span>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Category</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Category) ? "—" : Model.Category)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Dosage form</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.DosageForm) ? "—" : Model.DosageForm)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Strength</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Strength) ? "—" : Model.Strength)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Manufacturer</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.Manufacturer) ? "—" : Model.Manufacturer)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Unit price</div>
                <div class="col-8">@Model.UnitPrice.ToString("N2")</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Stock</div>
                <div class="col-8">@Model.StockQuantity (minimum level @Model.MinStockLevel)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Batch number</div>
                <div class="col-8">@(string.IsNullOrWhiteSpace(Model.BatchNumber) ? "—" : Model.BatchNumber)</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Expiry date</div>
                <div class="col-8">@Model.ExpiryDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Added on</div>
                <div class="col-8">@Model.CreatedDate.ToString("MMM dd, yyyy")</div>
            </div>
        </div>
    </div>
</div>
