@model MedyxHMS.ViewModels.HospitalAccessViewModel
@{
    ViewData["Title"] = "Staff Access - " + Model.Hospital.Name;
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-user-lock text-primary me-2"></i>Staff Access: @Model.Hospital.Name</h4>
            <small class="text-muted">Tick the staff who can work in this hospital. "Default" is the hospital selected for them after signing in.</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Hospitals</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="alert alert-light border small py-2">
        Staff with no hospital assigned work in the default hospital@(Model.Hospital.IsDefault ? " (this one)" : string.Empty).
        SuperAdmins can always switch to every hospital@(Model.CanEditAdmins ? string.Empty : "; only a SuperAdmin assigns hospitals to administrators (Admin and SuperAdmin accounts)").
    </div>

    <form asp-action="Access" asp-route-id="@Model.Hospital.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm">
            <div class="card-body table-responsive">
                <input type="search" id="accessFilter" class="form-control form-control-sm mb-2" style="max-width:320px" placeholder="Filter by name, username or role" />
                <table class="table table-hover align-middle" id="accessTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px">Access</th>
                            <th style="width:90px">Default</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Roles</th>
                            <th>Other hospitals</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var locked = (u.IsSuperAdmin || u.IsAdmin) && !Model.CanEditAdmins;
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input access-box" name="assignedUserIds" value="@u.UserId" id="acc-@u.UserId" @(u.HasAccess ? "checked" : "") @(locked ? "disabled" : "") aria-label="Access for @u.UserName" />
                                </td>
                                <td>
                                    <input type="checkbox" class="form-check-input default-box" name="defaultUserIds" value="@u.UserId" @(u.IsDefault ? "checked" : "") @(locked || !u.HasAccess ? "disabled" : "") aria-label="Default hospital for @u.UserName" />
                                </td>
                                <td>@u.FullName @if (locked) { <i class="fas fa-lock text-muted small ms-1" title="Only a SuperAdmin assigns hospitals to administrators"></i> }</td>
                                <td><code>@u.UserName</code></td>
                                <td class="small">@u.Roles</td>
                                <td class="small">
                                    @if (u.OtherHospitals.Any()) { @string.Join(", ", u.OtherHospitals) }
                                    else if (u.ImplicitDefaultAccess) { <span class="text-muted">Not assigned (works here as the default hospital)</span> }
                                    else if (!u.HasAccess) { <span class="text-muted">Not assigned (works in the default hospital)</span> }
                                </td>
                            </tr>
                        }
                        @if (!Model.Users.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No active staff accounts.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Save Access</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('#accessTable tbody tr').forEach(function (row) {
                var access = row.querySelector('.access-box');
                var def = row.querySelector('.default-box');
                if (!access || !def) return;
                access.addEventListener('change', function () {
                    if (access.disabled) return;
                    def.disabled = !access.checked;
                    if (!access.checked) def.checked = false;
                });
            });
            var filter = document.getElementById('accessFilter');
            filter && filter.addEventListener('input', function () {
                var q = filter.value.toLowerCase();
                document.querySelectorAll('#accessTable tbody tr').forEach(function (row) {
                    row.style.display = row.textContent.toLowerCase().indexOf(q) >= 0 ? '' : 'none';
                });
            });
        })();
    </script>
}
